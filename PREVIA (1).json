{"content":[{"id":"148b91a2","settings":{"boxed_width":{"unit":"px","size":360,"sizes":[]},"boxed_width_mobile":{"unit":"px","size":360,"sizes":[]},"min_height":{"unit":"px","size":640,"sizes":[]},"margin_mobile":{"unit":"px","top":"0","right":"0","bottom":"50","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"5c2813a","settings":{"html":"<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>V\u00eddeo Protegido<\/title>\n    <style>\n        body {\n            margin: 0;\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            height: 100vh;\n            background-color: #fff;\n            overflow: hidden;\n            text-align: center;\n        }\n        #video-container {\n            display: flex;\n            justify-content: center;\n            align-items: center;\n            width: 360px;\n            height: 640px;\n            position: relative;\n        }\n        video {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            border: none;\n        }\n        #mensagem {\n            display: none;\n            color: #000;\n            font-size: 16px;\n            text-align: center;\n            position: fixed;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            max-width: 80%;\n            line-height: 1.4;\n            word-wrap: break-word;\n        }\n        #playButton {\n            display: none;\n            position: absolute;\n            top: 50%;\n            left: 50%;\n            transform: translate(-50%, -50%);\n            padding: 10px 20px;\n            font-size: 18px;\n            background-color: #ff0000;\n            color: white;\n            border: none;\n            cursor: pointer;\n            border-radius: 5px;\n        }\n    <\/style>\n<\/head>\n<body>\n\n<div id=\"video-container\">\n    <video id=\"meuVideo\" playsinline autoplay controls>\n        <source src=\"O LINK DO SEU VIDEO DE PREVIA AQUI\">\n        Seu navegador n\u00e3o suporta v\u00eddeos.\n    <\/video>\n    <button id=\"playButton\">Reproduzir V\u00eddeo<\/button>\n<\/div>\n\n<div id=\"mensagem\">ACESSO NEGADO! <br> Voc\u00ea deve comprar um pacote <br> ou chamada para ver mais.<\/div>\n\n<script>\n    document.addEventListener(\"DOMContentLoaded\", function () {\n        const video = document.getElementById(\"meuVideo\");\n        const mensagem = document.getElementById(\"mensagem\");\n        const videoContainer = document.getElementById(\"video-container\");\n        const playButton = document.getElementById(\"playButton\");\n\n        video.setAttribute(\"playsinline\", \"\"); \/\/ Evita fullscreen no iOS\n\n        function tentarReproduzir() {\n            let playPromise = video.play();\n            if (playPromise !== undefined) {\n                playPromise.catch(() => {\n                    console.log(\"Autoplay bloqueado. Exibindo bot\u00e3o de reprodu\u00e7\u00e3o.\");\n                    playButton.style.display = \"block\"; \/\/ Exibe bot\u00e3o se autoplay falhar\n                });\n            }\n        }\n\n        \/\/ For\u00e7a a reprodu\u00e7\u00e3o autom\u00e1tica\n        tentarReproduzir();\n\n        \/\/ Se o autoplay for bloqueado, usu\u00e1rio pode clicar no bot\u00e3o\n        playButton.addEventListener(\"click\", function () {\n            video.play();\n            playButton.style.display = \"none\"; \/\/ Esconde bot\u00e3o ap\u00f3s tocar\n        });\n\n        \/\/ Se o v\u00eddeo j\u00e1 foi bloqueado antes, exibe a mensagem\n        if (localStorage.getItem(\"bloqueado\") === \"true\") {\n            bloquearAcesso();\n        } else {\n            video.addEventListener(\"ended\", function () {\n                localStorage.setItem(\"bloqueado\", \"true\");\n                bloquearAcesso();\n            });\n        }\n\n        function bloquearAcesso() {\n            videoContainer.style.display = \"none\";\n            mensagem.style.display = \"block\";\n        }\n    });\n<\/script>\n\n<\/body>\n<\/html>\n"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"},{"id":"7946bb11","settings":[],"elements":[{"id":"154b9e87","settings":{"html":"<!-- Meta Pixel Code -->\n<script>\n!function(f,b,e,v,n,t,s)\n{if(f.fbq)return;n=f.fbq=function(){n.callMethod?\nn.callMethod.apply(n,arguments):n.queue.push(arguments)};\nif(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';\nn.queue=[];t=b.createElement(e);t.async=!0;\nt.src=v;s=b.getElementsByTagName(e)[0];\ns.parentNode.insertBefore(t,s)}(window, document,'script',\n'https:\/\/connect.facebook.net\/en_US\/fbevents.js');\nfbq('init', 'SEU PIXEL AQUI');\nfbq('track', 'PageView');\n<\/script>\n<noscript><img height=\"1\" width=\"1\" style=\"display:none\"\nsrc=\"https:\/\/www.facebook.com\/tr?id=28415500078094730&ev=PageView&noscript=1\"\n\/><\/noscript>\n<!-- End Meta Pixel Code -->"},"elements":[],"isInner":false,"widgetType":"html","elType":"widget"}],"isInner":false,"elType":"container"}],"page_settings":[],"version":"0.4","title":"PREVIA  ATUALIZADO","type":"page"}